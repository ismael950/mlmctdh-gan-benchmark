#######################################################################
### One-dimensional physical functions
#######################################################################

LABELS-SECTION

VNr = external1d{neutral_r.dat}
VAr = external1d{anionic_r.dat}
VNz = external1d{neutral_z.dat}
VAz = external1d{anionic_z.dat}
fz = external1d{coupling_z.dat}

fz2 = external1d{fz2.dat}
fzVAz = external1d{fzVAz.dat}
fzVNz = external1d{fzVNz.dat}
end-LABELS-SECTION


#######################################################################
### System Hamiltonian
###
### H =
###     T_r + T_z
###   + U_N(r,z)
###   + n_d [U_A(r,z)-U_N(r,z)]
###   + sum_k epsilon_k n_k
###   + sum_k W_k(z)(d^dagger c_k + c_k^dagger d)
###
### Using n_d = 1/2 + q_d:
###
### U_N + n_d(U_A-U_N)
### =
### 1/2(U_N+U_A) + q_d(U_A-U_N)
#######################################################################

