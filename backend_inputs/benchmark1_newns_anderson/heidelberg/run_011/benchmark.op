#######################################################################
### Benchmark 1: finite Newns-Anderson model
###
### Orbital ordering:
###
###   1: d
###   2: c1
###   3: c2
###   4: c3
###   5: c4
###   6: c5
###   7: c6
###
### Nuclear mode:
###
###   8: Q
###
### Fermionic modes use:
###
###   sigma_x =  2 dq^2
###   sigma_y = -2 I*dq
###   sigma_z =  2 q
###
### Occupation convention:
###
###   grid point 1 = empty
###   grid point 2 = occupied
###
### Therefore
###
###   n = 1/2 + q
###   (-1)^n = -2 q
###
### Molecule-metal hopping is implemented through
### Jordan-Wigner parity strings.
#######################################################################


OP_DEFINE-SECTION

title
Benchmark 1: finite Newns-Anderson Hamiltonian
end-title

end-OP_DEFINE-SECTION


#######################################################################
### Parameters
#######################################################################

PARAMETER-SECTION

# Nuclear frequency
omega = 0.0002

# Molecular orbital energy
ed = 0.005

# Metal orbital energies
ec1 = -0.0041666667
ec2 = -0.0025
ec3 = -0.0008333333
ec4 =  0.0008333333
ec5 =  0.0025
ec6 =  0.0041666667

# Constant molecule-metal coupling
V = 0.0001628675

# Linear molecular-energy dependence
#
# g Q n_d
g = -0.00178885438

# Constant generated by
#
# epsilon_i n_i = epsilon_i (q_i + 1/2)
#
# Sum_i epsilon_i / 2 = 0.0025
econst = 0.0025

end-PARAMETER-SECTION


#######################################################################
### System Hamiltonian
#######################################################################

HAMILTONIAN-SECTION

modes | d | c1 | c2 | c3 | c4 | c5 | c6 | Q


# ---------------------------------------------------------------------
# Constant electronic energy shift
# ---------------------------------------------------------------------

econst       |8 1


# ---------------------------------------------------------------------
# Electronic orbital energies
#
# n_i = q_i + 1/2
#
# The 1/2 contributions are collected in econst.
# ---------------------------------------------------------------------

ed            |1 q

ec1           |2 q
ec2           |3 q
ec3           |4 q
ec4           |5 q
ec5           |6 q
ec6           |7 q


# ---------------------------------------------------------------------
# Nuclear Hamiltonian
#
# H_Q = omega/2 (P^2 + Q^2)
#
# With the dimensionless HO primitive basis:
#
# omega * KE + omega/2 * q^2
# ---------------------------------------------------------------------

omega         |8 KE
0.5*omega     |8 q^2


# ---------------------------------------------------------------------
# Electron-nuclear coupling
#
# g Q n_d
# = g Q (q_d + 1/2)
# ---------------------------------------------------------------------

0.5*g         |8 q
g             |1 q     |8 q


# =====================================================================
# Molecule-metal hopping
#
# V (d^dagger c_k + c_k^dagger d)
#
# Jordan-Wigner:
#
# 1/2 [
#   X_d Z ... Z X_ck
#   +
#   Y_d Z ... Z Y_ck
# ]
#
# For the Heidelberg spin DVR:
#
# X = 2 dq^2
# Y = -2 I*dq
# parity = -2 q
# =====================================================================


# ---------------------------------------------------------------------
# d <-> c1
# No intermediate parity operator.
# ---------------------------------------------------------------------

2.0*V         |1 dq^2     |2 dq^2
2.0*V         |1 I*dq     |2 I*dq


# ---------------------------------------------------------------------
# d <-> c2
# Parity string: c1
# ---------------------------------------------------------------------

-4.0*V        |1 dq^2     |2 q        |3 dq^2
-4.0*V        |1 I*dq     |2 q        |3 I*dq


# ---------------------------------------------------------------------
# d <-> c3
# Parity string: c1 c2
# ---------------------------------------------------------------------

8.0*V         |1 dq^2     |2 q        |3 q        |4 dq^2
8.0*V         |1 I*dq     |2 q        |3 q        |4 I*dq


# ---------------------------------------------------------------------
# d <-> c4
# Parity string: c1 c2 c3
# ---------------------------------------------------------------------

-16.0*V       |1 dq^2     |2 q        |3 q        |4 q        |5 dq^2
-16.0*V       |1 I*dq     |2 q        |3 q        |4 q        |5 I*dq


# ---------------------------------------------------------------------
# d <-> c5
# Parity string: c1 c2 c3 c4
# ---------------------------------------------------------------------

32.0*V        |1 dq^2     |2 q        |3 q        |4 q        |5 q        |6 dq^2
32.0*V        |1 I*dq     |2 q        |3 q        |4 q        |5 q        |6 I*dq


# ---------------------------------------------------------------------
# d <-> c6
# Parity string: c1 c2 c3 c4 c5
# ---------------------------------------------------------------------

-64.0*V       |1 dq^2     |2 q        |3 q        |4 q        |5 q        |6 q        |7 dq^2
-64.0*V       |1 I*dq     |2 q        |3 q        |4 q        |5 q        |6 q        |7 I*dq


end-HAMILTONIAN-SECTION


#######################################################################
### Observable: molecular population n_d
#######################################################################

HAMILTONIAN-SECTION_nd

modes | d | c1 | c2 | c3 | c4 | c5 | c6 | Q

0.5           |1 1
1.0           |1 q

end-HAMILTONIAN-SECTION


#######################################################################
### Observable: metal orbital population n_c1
#######################################################################

HAMILTONIAN-SECTION_nc1

modes | d | c1 | c2 | c3 | c4 | c5 | c6 | Q

0.5           |1 1
1.0           |2 q

end-HAMILTONIAN-SECTION


#######################################################################
### Observable: metal orbital population n_c2
#######################################################################

HAMILTONIAN-SECTION_nc2

modes | d | c1 | c2 | c3 | c4 | c5 | c6 | Q

0.5           |1 1
1.0           |3 q

end-HAMILTONIAN-SECTION


#######################################################################
### Observable: metal orbital population n_c3
#######################################################################

HAMILTONIAN-SECTION_nc3

modes | d | c1 | c2 | c3 | c4 | c5 | c6 | Q

0.5           |1 1
1.0           |4 q

end-HAMILTONIAN-SECTION


#######################################################################
### Observable: metal orbital population n_c4
#######################################################################

HAMILTONIAN-SECTION_nc4

modes | d | c1 | c2 | c3 | c4 | c5 | c6 | Q

0.5           |1 1
1.0           |5 q

end-HAMILTONIAN-SECTION


#######################################################################
### Observable: metal orbital population n_c5
#######################################################################

HAMILTONIAN-SECTION_nc5

modes | d | c1 | c2 | c3 | c4 | c5 | c6 | Q

0.5           |1 1
1.0           |6 q

end-HAMILTONIAN-SECTION


#######################################################################
### Observable: metal orbital population n_c6
#######################################################################

HAMILTONIAN-SECTION_nc6

modes | d | c1 | c2 | c3 | c4 | c5 | c6 | Q

0.5           |1 1
1.0           |7 q

end-HAMILTONIAN-SECTION


#######################################################################
### Observable: <Q>
#######################################################################

HAMILTONIAN-SECTION_Qmean

modes | d | c1 | c2 | c3 | c4 | c5 | c6 | Q

1.0           |8 q

end-HAMILTONIAN-SECTION


#######################################################################
### Observable: mean harmonic vibrational occupation
###
### n_vib = 1/2(P^2 + Q^2 - 1)
###        = KE + 1/2 q^2 - 1/2
#######################################################################

HAMILTONIAN-SECTION_nvib

modes | d | c1 | c2 | c3 | c4 | c5 | c6 | Q

-0.5          |8 1
1.0           |8 KE
0.5           |8 q^2

end-HAMILTONIAN-SECTION


END-OPERATOR