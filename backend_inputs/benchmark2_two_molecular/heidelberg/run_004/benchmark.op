#######################################################################
### Benchmark 2: two molecular orbitals
### Small ML-MCTDH/SQR validation benchmark
###
### Orbital ordering:
###
###   1: d1
###   2: d2
###   3: c1
###   4: c2
###   5: c3
###   6: c4
###
### Nuclear mode:
###
###   7: Q
###
### Fermionic convention:
###
###   n = 1/2 + q
###   parity = (-1)^n = -2 q
###
### Hopping terms use Jordan-Wigner parity strings.
#######################################################################


OP_DEFINE-SECTION

title
Benchmark 2: two-molecular-orbital Newns-Anderson model
end-title

end-OP_DEFINE-SECTION


#######################################################################
### Parameters
#######################################################################

PARAMETER-SECTION

omega = 0.0002

# Molecular orbital energies
ed1 = 0.003
ed2 = 0.005

# Metal orbital energies
ec1 = -0.003
ec2 = -0.001
ec3 =  0.001
ec4 =  0.003

# Molecule-metal couplings
V1 = 0.00025
V2 = 0.00020

# Q-dependent molecular energies
g1 = -0.0012
g2 = -0.0008

# Constant electronic contribution from
# epsilon_i n_i = epsilon_i(q_i + 1/2)
econst = 0.004

# Constant-in-electronic-space Q term generated by
#
# g1 Q n_d1 + g2 Q n_d2
#
# = 1/2(g1+g2) Q
#   + g1 q_d1 Q
#   + g2 q_d2 Q
g0 = -0.001

end-PARAMETER-SECTION


#######################################################################
### Hamiltonian
#######################################################################

HAMILTONIAN-SECTION

modes | d1 | d2 | c1 | c2 | c3 | c4 | Q


# ---------------------------------------------------------------------
# Constant electronic energy shift
# ---------------------------------------------------------------------

econst       |7 1


# ---------------------------------------------------------------------
# Electronic orbital energies
# ---------------------------------------------------------------------

ed1          |1 q
ed2          |2 q

ec1          |3 q
ec2          |4 q
ec3          |5 q
ec4          |6 q


# ---------------------------------------------------------------------
# Nuclear Hamiltonian
#
# omega/2 (P^2 + Q^2)
# ---------------------------------------------------------------------

omega        |7 KE
0.5*omega    |7 q^2


# ---------------------------------------------------------------------
# Q-dependent molecular energies
#
# g1 Q n_d1 + g2 Q n_d2
# ---------------------------------------------------------------------

g0           |7 q

g1           |1 q     |7 q
g2           |2 q     |7 q


# =====================================================================
# d1 <-> metal hopping
# =====================================================================


# ---------------------------------------------------------------------
# d1 <-> c1
# Intermediate parity mode: d2
# ---------------------------------------------------------------------

-4.0*V1      |1 dq^2     |2 q        |3 dq^2
-4.0*V1      |1 I*dq     |2 q        |3 I*dq


# ---------------------------------------------------------------------
# d1 <-> c2
# Intermediate parity modes: d2, c1
# ---------------------------------------------------------------------

8.0*V1       |1 dq^2     |2 q        |3 q        |4 dq^2
8.0*V1       |1 I*dq     |2 q        |3 q        |4 I*dq


# ---------------------------------------------------------------------
# d1 <-> c3
# Intermediate parity modes: d2, c1, c2
# ---------------------------------------------------------------------

-16.0*V1     |1 dq^2     |2 q        |3 q        |4 q        |5 dq^2
-16.0*V1     |1 I*dq     |2 q        |3 q        |4 q        |5 I*dq


# ---------------------------------------------------------------------
# d1 <-> c4
# Intermediate parity modes: d2, c1, c2, c3
# ---------------------------------------------------------------------

32.0*V1      |1 dq^2     |2 q        |3 q        |4 q        |5 q        |6 dq^2
32.0*V1      |1 I*dq     |2 q        |3 q        |4 q        |5 q        |6 I*dq


# =====================================================================
# d2 <-> metal hopping
# =====================================================================


# ---------------------------------------------------------------------
# d2 <-> c1
# No intermediate parity mode
# ---------------------------------------------------------------------

2.0*V2       |2 dq^2     |3 dq^2
2.0*V2       |2 I*dq     |3 I*dq


# ---------------------------------------------------------------------
# d2 <-> c2
# Intermediate parity mode: c1
# ---------------------------------------------------------------------

-4.0*V2      |2 dq^2     |3 q        |4 dq^2
-4.0*V2      |2 I*dq     |3 q        |4 I*dq


# ---------------------------------------------------------------------
# d2 <-> c3
# Intermediate parity modes: c1, c2
# ---------------------------------------------------------------------

8.0*V2       |2 dq^2     |3 q        |4 q        |5 dq^2
8.0*V2       |2 I*dq     |3 q        |4 q        |5 I*dq


# ---------------------------------------------------------------------
# d2 <-> c4
# Intermediate parity modes: c1, c2, c3
# ---------------------------------------------------------------------

-16.0*V2     |2 dq^2     |3 q        |4 q        |5 q        |6 dq^2
-16.0*V2     |2 I*dq     |3 q        |4 q        |5 q        |6 I*dq


end-HAMILTONIAN-SECTION


#######################################################################
### Molecular populations
#######################################################################

HAMILTONIAN-SECTION_nd1

modes | d1 | d2 | c1 | c2 | c3 | c4 | Q

0.5          |1 1
1.0          |1 q

end-HAMILTONIAN-SECTION


HAMILTONIAN-SECTION_nd2

modes | d1 | d2 | c1 | c2 | c3 | c4 | Q

0.5          |1 1
1.0          |2 q

end-HAMILTONIAN-SECTION


#######################################################################
### Metal populations
#######################################################################

HAMILTONIAN-SECTION_nc1

modes | d1 | d2 | c1 | c2 | c3 | c4 | Q

0.5          |1 1
1.0          |3 q

end-HAMILTONIAN-SECTION


HAMILTONIAN-SECTION_nc2

modes | d1 | d2 | c1 | c2 | c3 | c4 | Q

0.5          |1 1
1.0          |4 q

end-HAMILTONIAN-SECTION


HAMILTONIAN-SECTION_nc3

modes | d1 | d2 | c1 | c2 | c3 | c4 | Q

0.5          |1 1
1.0          |5 q

end-HAMILTONIAN-SECTION


HAMILTONIAN-SECTION_nc4

modes | d1 | d2 | c1 | c2 | c3 | c4 | Q

0.5          |1 1
1.0          |6 q

end-HAMILTONIAN-SECTION


#######################################################################
### Nuclear coordinate
#######################################################################

HAMILTONIAN-SECTION_Qmean

modes | d1 | d2 | c1 | c2 | c3 | c4 | Q

1.0          |7 q

end-HAMILTONIAN-SECTION


#######################################################################
### Harmonic vibrational occupation
###
### n_vib = KE + 1/2 Q^2 - 1/2
#######################################################################

HAMILTONIAN-SECTION_nvib

modes | d1 | d2 | c1 | c2 | c3 | c4 | Q

-0.5         |7 1
1.0          |7 KE
0.5          |7 q^2

end-HAMILTONIAN-SECTION


END-OPERATOR