#######################################################################
### Small direct benchmark operator
###
### Modes:
###   1 d1, 2 d2 : molecular orbitals
###   3 c1 ... 6 c4 : finite metal bath
###   7 Q : nuclear coordinate
###
### Fermionic SQR convention:
###   n = 1/2 + q
###   parity = (-1)^n = -2 q
#######################################################################

OP_DEFINE-SECTION

title
K=32 direct GAN benchmark: exact Hamiltonian used by Python reference
end-title

end-OP_DEFINE-SECTION


PARAMETER-SECTION

# Nuclear mass M = 1/omega = 5000.
mass_Q = 5000.0
kQ = 0.0001

# Molecular orbital energies.
ed1 = 0.003
ed2 = 0.005

# Metal energies.
ec1 = -0.003
ec2 = -0.001
ec3 =  0.001
ec4 =  0.003

# Q-dependent molecular energies.
g1 = -0.0012
g2 = -0.0008

# Constant electronic contribution from
# ed1*n_d1 + ed2*n_d2.
econst = 0.004

# Q-only contribution from
# g1*Q*n_d1 + g2*Q*n_d2.
g0 = -0.001

# Constant molecular-molecular hopping.
Vmm = 0.00015

# Molecule-metal hopping amplitudes before switching.
V1 = 0.00025
V2 = 0.00020

end-PARAMETER-SECTION


LABELS-SECTION

# One value per Q-grid point:
# s(Q) = 0.5*(1 - tanh(Q)).
sw = read1d{switching.dat ascii}

end-LABELS-SECTION


HAMILTONIAN-SECTION

modes | d1 | d2 | c1 | c2 | c3 | c4 | Q

# Nuclear kinetic + harmonic potential:
# P^2/(2M) + 0.0001 Q^2.
1.0          |7 KE
kQ           |7 q^2

# Constant shift generated by n_i = 1/2 + q_i.
econst       |7 1

# Orbital energies.
ed1          |1 q
ed2          |2 q
ec1          |3 q
ec2          |4 q
ec3          |5 q
ec4          |6 q

# Q-dependent molecular orbital energies.
g0           |7 q
g1           |1 q     |7 q
g2           |2 q     |7 q

# ---------------------------------------------------------------
# d1 <-> d2, constant hopping Vmm.
# Adjacent modes: no Jordan-Wigner parity string.
# ---------------------------------------------------------------
2.0*Vmm      |1 dq^2     |2 dq^2
2.0*Vmm      |1 I*dq     |2 I*dq

# ---------------------------------------------------------------
# d1 <-> metal, all multiplied by s(Q).
# ---------------------------------------------------------------

# d1 <-> c1 ; parity: d2
-4.0*V1      |1 dq^2     |2 q        |3 dq^2     |7 sw
-4.0*V1      |1 I*dq     |2 q        |3 I*dq     |7 sw

# d1 <-> c2 ; parity: d2,c1
8.0*V1       |1 dq^2     |2 q        |3 q        |4 dq^2     |7 sw
8.0*V1       |1 I*dq     |2 q        |3 q        |4 I*dq     |7 sw

# d1 <-> c3 ; parity: d2,c1,c2
-16.0*V1     |1 dq^2     |2 q        |3 q        |4 q        |5 dq^2     |7 sw
-16.0*V1     |1 I*dq     |2 q        |3 q        |4 q        |5 I*dq     |7 sw

# d1 <-> c4 ; parity: d2,c1,c2,c3
32.0*V1      |1 dq^2     |2 q        |3 q        |4 q        |5 q        |6 dq^2     |7 sw
32.0*V1      |1 I*dq     |2 q        |3 q        |4 q        |5 q        |6 I*dq     |7 sw

# ---------------------------------------------------------------
# d2 <-> metal, all multiplied by s(Q).
# ---------------------------------------------------------------

# d2 <-> c1 ; adjacent
2.0*V2       |2 dq^2     |3 dq^2     |7 sw
2.0*V2       |2 I*dq     |3 I*dq     |7 sw

# d2 <-> c2 ; parity: c1
-4.0*V2      |2 dq^2     |3 q        |4 dq^2     |7 sw
-4.0*V2      |2 I*dq     |3 q        |4 I*dq     |7 sw

# d2 <-> c3 ; parity: c1,c2
8.0*V2       |2 dq^2     |3 q        |4 q        |5 dq^2     |7 sw
8.0*V2       |2 I*dq     |3 q        |4 q        |5 I*dq     |7 sw

# d2 <-> c4 ; parity: c1,c2,c3
-16.0*V2     |2 dq^2     |3 q        |4 q        |5 q        |6 dq^2     |7 sw
-16.0*V2     |2 I*dq     |3 q        |4 q        |5 q        |6 I*dq     |7 sw

end-HAMILTONIAN-SECTION


HAMILTONIAN-SECTION_nd1
modes | d1 | d2 | c1 | c2 | c3 | c4 | Q
0.5          |1 1
1.0          |1 q
end-HAMILTONIAN-SECTION

HAMILTONIAN-SECTION_nd2
modes | d1 | d2 | c1 | c2 | c3 | c4 | Q
0.5          |1 1
1.0          |2 q
end-HAMILTONIAN-SECTION

HAMILTONIAN-SECTION_nc1
modes | d1 | d2 | c1 | c2 | c3 | c4 | Q
0.5          |1 1
1.0          |3 q
end-HAMILTONIAN-SECTION

HAMILTONIAN-SECTION_nc2
modes | d1 | d2 | c1 | c2 | c3 | c4 | Q
0.5          |1 1
1.0          |4 q
end-HAMILTONIAN-SECTION

HAMILTONIAN-SECTION_nc3
modes | d1 | d2 | c1 | c2 | c3 | c4 | Q
0.5          |1 1
1.0          |5 q
end-HAMILTONIAN-SECTION

HAMILTONIAN-SECTION_nc4
modes | d1 | d2 | c1 | c2 | c3 | c4 | Q
0.5          |1 1
1.0          |6 q
end-HAMILTONIAN-SECTION

HAMILTONIAN-SECTION_Qmean
modes | d1 | d2 | c1 | c2 | c3 | c4 | Q
1.0          |7 q
end-HAMILTONIAN-SECTION


END-OPERATOR
